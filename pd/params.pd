#N canvas 60 60 760 280 10;
#X text 10 5 PARAMS - edit boxes or bang init to (re)send defaults;
#X text 10 17 banging init also RESETS the simulation state to x0/v0/angles0;
#X obj 10 38 loadbang;
#X obj 90 38 bng 18 250 50 0 empty empty empty 17 7 0 10 -262144 -1 -1;
#X text 115 40 init / reset;
