#N canvas 60 60 1080 620 10;
#X text 10 5 DYNAMICS - 6DOF rigid body \, explicit Euler at audio rate;
#X text 10 17 outputs: x y z vx vy vz phi theta psi p q r;
#X obj 10 48 inlet~;
#X text 10 33 Fz;
#X obj 80 48 inlet~;
#X text 80 33 Tx;
#X obj 150 48 inlet~;
#X text 150 33 Ty;
#X obj 220 48 inlet~;
#X text 220 33 Tz;
#X obj 310 48 loadbang;
#X obj 310 70 samplerate~;
#X obj 310 92 expr 1.0 / \$f1;
#X obj 420 48 r pq_Ixx;
#X obj 500 48 r pq_Iyy;
#X obj 580 48 r pq_Izz;
#X obj 660 48 r pq_mass;
#X obj 740 48 r pq_g;
#X text 10 135 ROT: p q r phi theta psi (gyroscopic coupling + ZYX Euler kinematics);
#X obj 10 152 fexpr~ \$y1[-1] + (\$x1[0] + (\$f5 - \$f6) * \$y2[-1] * \$y3[-1]) / max(\$f4 \, 0.000001) * \$f7 \; \$y2[-1] + (\$x2[0] + (\$f6 - \$f4) * \$y1[-1] * \$y3[-1]) / max(\$f5 \, 0.000001) * \$f7 \; \$y3[-1] + (\$x3[0] + (\$f4 - \$f5) * \$y1[-1] * \$y2[-1]) / max(\$f6 \, 0.000001) * \$f7 \; \$y4[-1] + (\$y1[-1] + sin(\$y4[-1]) * tan(\$y5[-1]) * \$y2[-1] + cos(\$y4[-1]) * tan(\$y5[-1]) * \$y3[-1]) * \$f7 \; \$y5[-1] + (cos(\$y4[-1]) * \$y2[-1] - sin(\$y4[-1]) * \$y3[-1]) * \$f7 \; \$y6[-1] + (sin(\$y4[-1]) * \$y2[-1] + cos(\$y4[-1]) * \$y3[-1]) / max(cos(\$y5[-1]) \, 0.001) * \$f7;
#X text 10 255 TRANS: vx vy vz x y z (body-z thrust rotated to world \, minus gravity);
#X obj 10 272 fexpr~ \$y1[-1] + (cos(\$x4[0]) * sin(\$x3[0]) * cos(\$x2[0]) + sin(\$x4[0]) * sin(\$x2[0])) * \$x1[0] / max(\$f5 \, 0.0001) * \$f7 \; \$y2[-1] + (sin(\$x4[0]) * sin(\$x3[0]) * cos(\$x2[0]) - cos(\$x4[0]) * sin(\$x2[0])) * \$x1[0] / max(\$f5 \, 0.0001) * \$f7 \; \$y3[-1] + (cos(\$x3[0]) * cos(\$x2[0]) * \$x1[0] / max(\$f5 \, 0.0001) - \$f6) * \$f7 \; \$y4[-1] + \$y1[-1] * \$f7 \; \$y5[-1] + \$y2[-1] * \$f7 \; \$y6[-1] + \$y3[-1] * \$f7;
#X text 10 375 initial conditions: pq_* sends -> set y<n> messages reset fexpr~ state;
#X obj 10 395 r pq_phi0;
#X msg 10 417 set y4 \$1;
#X obj 220 395 r pq_theta0;
#X msg 220 417 set y5 \$1;
#X obj 430 395 r pq_psi0;
#X msg 430 417 set y6 \$1;
#X obj 640 395 r pq_vx0;
#X msg 640 417 set y1 \$1;
#X obj 850 395 r pq_vy0;
#X msg 850 417 set y2 \$1;
#X obj 10 447 r pq_vz0;
#X msg 10 469 set y3 \$1;
#X obj 220 447 r pq_x0;
#X msg 220 469 set y4 \$1;
#X obj 430 447 r pq_y0;
#X msg 430 469 set y5 \$1;
#X obj 640 447 r pq_z0;
#X msg 640 469 set y6 \$1;
#X obj 10 505 r pq_phi0;
#X msg 10 527 set y1 0 \, set y2 0 \, set y3 0;
#X obj 10 565 outlet~;
