#N canvas 60 60 1060 640 10;
#X text 10 4 PUREQUAD - Pure Data 4D quadcopter simulation (expr~ / fexpr~);
#X text 10 16 1. turn DSP ON 2. fly with Thrust / Roll / Pitch / Yaw 3. bang init in [params] to reset;
#X text 10 28 physics at audio rate - numeric state display every 50 ms;
#X msg 720 4 \; pd dsp 1;
#X msg 800 4 \; pd dsp 0;
#X text 880 6 <- DSP on/off;
#X obj 10 52 params;
#X text 70 54 <- all quadcopter parameters (open it / bang init to reset);
#X text 10 84 CONTROLS;
#X obj 950 100 loadbang;
#X text 10 100 Thrust T (N);
#X floatatom 10 116 9 0 32 0 - - -;
#X obj 10 138 sig~;
#X msg 115 116 11.772;
#X text 245 100 Roll tx (N.m);
#X floatatom 245 116 9 -4 4 0 - - -;
#X obj 245 138 sig~;
#X msg 350 116 0;
#X text 480 100 Pitch ty (N.m);
#X floatatom 480 116 9 -4 4 0 - - -;
#X obj 480 138 sig~;
#X msg 585 116 0;
#X text 715 100 Yaw tz (N.m);
#X floatatom 715 116 9 -4 4 0 - - -;
#X obj 715 138 sig~;
#X msg 820 116 0;
#X obj 10 175 mixer;
#X obj 10 200 force_torque;
#X obj 10 225 dynamics;
#X text 120 177 T/R/P/Y -> per-motor thrusts (slope + range clamp);
#X text 120 202 motor thrusts -> body Fz Tx Ty Tz;
#X text 120 227 6DOF integration -> 12-state output;
#X text 10 262 STATE (sampled every 50 ms);
#X obj 10 280 metro 50;
#X obj 90 280 loadbang;
#X obj 10 310 snapshot~;
#X floatatom 90 310 12 -1000000000.0 1000000000.0 0 - - -;
#X text 10 330 x (m);
#X obj 360 310 snapshot~;
#X floatatom 440 310 12 -1000000000.0 1000000000.0 0 - - -;
#X text 360 330 y (m);
#X obj 710 310 snapshot~;
#X floatatom 790 310 12 -1000000000.0 1000000000.0 0 - - -;
#X text 710 330 z (m);
#X obj 10 372 snapshot~;
#X floatatom 90 372 12 -1000000000.0 1000000000.0 0 - - -;
#X text 10 392 vx (m/s);
#X obj 360 372 snapshot~;
#X floatatom 440 372 12 -1000000000.0 1000000000.0 0 - - -;
#X text 360 392 vy (m/s);
#X obj 710 372 snapshot~;
#X floatatom 790 372 12 -1000000000.0 1000000000.0 0 - - -;
#X text 710 392 vz (m/s);
#X obj 10 434 snapshot~;
#X floatatom 90 434 12 -1000000000.0 1000000000.0 0 - - -;
#X text 10 454 phi roll (rad);
#X obj 360 434 snapshot~;
#X floatatom 440 434 12 -1000000000.0 1000000000.0 0 - - -;
#X text 360 454 theta pitch (rad);
#X obj 710 434 snapshot~;
#X floatatom 790 434 12 -1000000000.0 1000000000.0 0 - - -;
#X text 710 454 psi yaw (rad);
#X obj 10 496 snapshot~;
#X floatatom 90 496 12 -1000000000.0 1000000000.0 0 - - -;
#X text 10 516 p (rad/s);
#X obj 360 496 snapshot~;
#X floatatom 440 496 12 -1000000000.0 1000000000.0 0 - - -;
#X text 360 516 q (rad/s);
#X obj 710 496 snapshot~;
#X floatatom 790 496 12 -1000000000.0 1000000000.0 0 - - -;
#X text 710 516 r (rad/s);
