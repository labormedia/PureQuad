#N canvas 60 60 700 300 10;
#X text 10 5 FORCE-TORQUE: clamped motor thrusts -> total thrust + body torques;
#X obj 10 45 inlet~;
#X text 10 30 F1 FR;
#X obj 100 45 inlet~;
#X text 100 30 F2 RL;
#X obj 190 45 inlet~;
#X text 190 30 F3 FL;
#X obj 280 45 inlet~;
#X text 280 30 F4 RR;
#X obj 420 45 r pq_L;
#X obj 490 45 r pq_km;
#X obj 10 90 expr~ \$v1 + \$v2 + \$v3 + \$v4;
#X obj 10 120 expr~ \$f5 * (\$v2 + \$v3 - \$v1 - \$v4);
#X obj 10 150 expr~ \$f5 * (\$v1 + \$v3 - \$v2 - \$v4);
#X obj 10 180 expr~ \$f5 * (\$v3 + \$v4 - \$v1 - \$v2);
#X obj 10 230 outlet~;
#X text 10 248 Fz (N);
#X obj 110 230 outlet~;
#X text 110 248 Tx (N.m);
#X obj 210 230 outlet~;
#X text 210 248 Ty (N.m);
#X obj 310 230 outlet~;
#X text 310 248 Tz (N.m);
