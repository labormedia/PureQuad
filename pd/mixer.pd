#N canvas 60 60 980 330 10;
#X text 10 5 MIXER: T tx ty tz -> F1..F4 (slope applied then clamped to thrust range);
#X text 10 17 X config: M1 FR/CW M2 RL/CW M3 FL/CCW M4 RR/CCW;
#X obj 10 45 inlet~;
#X text 10 30 T (N);
#X obj 90 45 inlet~;
#X text 90 30 tx (N.m);
#X obj 170 45 inlet~;
#X text 170 30 ty (N.m);
#X obj 250 45 inlet~;
#X text 250 30 tz (N.m);
#X obj 340 45 r pq_L;
#X obj 420 45 r pq_km;
#X obj 500 45 r pq_Tslope;
#X obj 600 45 r pq_Tmin;
#X obj 690 45 r pq_Tmax;
#X obj 10 85 expr~ max(\$f8 \, min(\$f9 \, \$f7 * (\$v1 - \$v2 / max(\$f5 \, 0.0001) + \$v3 / max(\$f5 \, 0.0001) - \$v4 / max(\$f6 \, 0.0001)) * 0.25));
#X obj 10 117 expr~ max(\$f8 \, min(\$f9 \, \$f7 * (\$v1 + \$v2 / max(\$f5 \, 0.0001) - \$v3 / max(\$f5 \, 0.0001) - \$v4 / max(\$f6 \, 0.0001)) * 0.25));
#X obj 10 149 expr~ max(\$f8 \, min(\$f9 \, \$f7 * (\$v1 + \$v2 / max(\$f5 \, 0.0001) + \$v3 / max(\$f5 \, 0.0001) + \$v4 / max(\$f6 \, 0.0001)) * 0.25));
#X obj 10 181 expr~ max(\$f8 \, min(\$f9 \, \$f7 * (\$v1 - \$v2 / max(\$f5 \, 0.0001) - \$v3 / max(\$f5 \, 0.0001) + \$v4 / max(\$f6 \, 0.0001)) * 0.25));
